#include <windows.h>

#define IDI_JUDGEBOX 101

IDI_JUDGEBOX ICON "JudgeBox.ico"
1 RT_MANIFEST "JudgeBox.manifest"

1 VERSIONINFO
FILEVERSION 1,3,0,0
PRODUCTVERSION 1,3,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "JudgeBox"
            VALUE "FileDescription", "JudgeBox offline judge"
            VALUE "FileVersion", "1.3.0.0"
            VALUE "InternalName", "JudgeBox"
            VALUE "LegalCopyright", "Copyright (C) 2026 JudgeBox"
            VALUE "OriginalFilename", "JudgeBox.exe"
            VALUE "ProductName", "JudgeBox"
            VALUE "ProductVersion", "1.3.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
